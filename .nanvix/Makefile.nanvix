# Licensed under the MIT License.
#
# Usage: make -f .nanvix/Makefile.nanvix PLATFORM=<platform> PROCESS_MODE=<mode> \
#    MEMORY_SIZE=<size> NANVIX_HOME=<home> NANVIX_BUILDROOT=<buildroot> \
#    NANVIX_TOOLCHAIN=<toolchain> [target]
#
# Targets:
#   all              Build libxml2.a and the integration test ELF
#   test             Run all tests (smoke, integration, functional)
#   test-smoke       Verify build artifacts (no runtime)
#   test-integration Verify the test ELF was produced
#   test-functional  Run the test ELF on nanvixd.elf
#   package          Create a release tarball with libs, headers, xml2-config
#   verify-package   Verify the contents of the release tarball
#   clean            Remove build artifacts

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is expected to be invoked via z.py.
# 2. Build goals require the cross-toolchain at $(NANVIX_TOOLCHAIN); other
#    goals (test-*, package, verify-package, clean) are pure host-side.
# 3. Build ALWAYS runs before test and release.

.DEFAULT_GOAL=all
EXE = .elf

STATICLIB := .libs/libxml2.a
TEST_SRC  := .nanvix/test/test_libxml2.c
TEST_ELF  := test_libxml2$(EXE)

_NANVIX_DOCKER_BUILD_GOALS := all $(STATICLIB) $(TEST_ELF)
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined.
_REQUIRED := PLATFORM PROCESS_MODE MEMORY_SIZE NANVIX_HOME NANVIX_BUILDROOT NANVIX_TOOLCHAIN
ifneq ($(filter-out clean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

SYSROOT_PATH   := $(abspath $(NANVIX_HOME))
BUILDROOT_PATH := $(abspath $(NANVIX_BUILDROOT))
NPROC := $(shell nproc 2>/dev/null || echo 4)

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc),)
    $(error Nanvix toolchain not found at $(NANVIX_TOOLCHAIN))
  endif
endif

# ===========================================================================
# Build Targets
# ===========================================================================

all: $(STATICLIB) $(TEST_ELF)

$(STATICLIB):
	sh -c '\
	  export PATH="$(NANVIX_TOOLCHAIN)/bin:$$PATH" && \
	  ./configure --host=i686-nanvix \
	    --prefix=/usr/local \
	    --enable-static --disable-shared --disable-maintainer-mode \
	    --without-python --without-threads --without-http --without-ftp \
	    --without-lzma --without-debug --without-catalog --without-readline \
	    --without-history --without-modules \
	    --with-zlib="$(BUILDROOT_PATH)" \
	    CFLAGS="-I$(BUILDROOT_PATH)/include" \
	    LDFLAGS="-L$(BUILDROOT_PATH)/lib" && \
	  make -j$(NPROC) libxml2.la'

$(TEST_ELF): $(TEST_SRC)
	@test -f $(STATICLIB) || { echo "  FAIL: $(STATICLIB) not found; run 'build' first"; exit 1; }
	$(NANVIX_TOOLCHAIN)/bin/i686-nanvix-gcc \
	  -Iinclude -Iinclude/libxml \
	  $(TEST_SRC) \
	  -L.libs -L$(BUILDROOT_PATH)/lib -L$(SYSROOT_PATH)/lib \
	  -T$(SYSROOT_PATH)/lib/user.ld -static -Wl,-z,noexecstack \
	  -lxml2 -lz \
	  -Wl,--start-group \
	  $(SYSROOT_PATH)/lib/libposix.a \
	  $(NANVIX_TOOLCHAIN)/i686-nanvix/lib/libc.a \
	  $(NANVIX_TOOLCHAIN)/i686-nanvix/lib/libm.a \
	  -Wl,--end-group \
	  -o $@

# ===========================================================================
# Test Targets
# ===========================================================================

test-smoke:
	@echo "=== libxml2 smoke tests ==="
	@test -f $(STATICLIB) || { echo "  FAIL: $(STATICLIB) not found"; exit 1; }
	@size=$$(wc -c < $(STATICLIB)); \
	  if [ "$$size" -lt 1000 ]; then echo "  FAIL: $(STATICLIB) too small ($$size bytes)"; exit 1; fi
	@echo "  PASS: libxml2 smoke tests"

test-integration:
	@echo "=== libxml2 integration tests ==="
	@test -f $(TEST_ELF) || { echo "  FAIL: $(TEST_ELF) not built"; exit 1; }
	@size=$$(wc -c < $(TEST_ELF)); \
	  if [ "$$size" -lt 1000 ]; then echo "  FAIL: $(TEST_ELF) too small ($$size bytes)"; exit 1; fi
	@echo "  OK: $(TEST_ELF) ($$size bytes)"
	@echo "  PASS: libxml2 integration tests"

test-functional:
	@echo "=== libxml2 functional tests ==="
	@test -f $(TEST_ELF) || { echo "  FAIL: $(TEST_ELF) not built"; exit 1; }
	@echo "  Running $(TEST_ELF) via nanvixd.elf (platform=$(PLATFORM), mode=$(PROCESS_MODE))..."
	@TMPDIR=$$(mktemp -d /tmp/nanvix-libxml2-XXXXXX) && \
	  trap "rm -rf $$TMPDIR" EXIT && \
	  mkdir -p $$TMPDIR/ramfs/tmp && \
	  "$(SYSROOT_PATH)/bin/mkramfs.elf" -o $$TMPDIR/rootfs.img $$TMPDIR/ramfs/ && \
	  cd "$(SYSROOT_PATH)" && timeout --foreground 120 ./bin/nanvixd.elf \
	    -bin-dir ./bin -ramfs $$TMPDIR/rootfs.img \
	    -- $(abspath $(TEST_ELF))
	@echo "  PASS: $(TEST_ELF) (exit code 0)"
	@echo "  PASS: libxml2 functional tests"

test: test-smoke test-integration test-functional
	@echo "=== All libxml2 tests PASSED ==="

# ===========================================================================
# Package Target
# ===========================================================================

package:
	@echo "=== Packaging libxml2 release ==="
	$(eval ARTIFACT_NAME := libxml2-$(PLATFORM)-$(PROCESS_MODE)-$(MEMORY_SIZE))
	@test -f $(STATICLIB) || { echo "  FAIL: $(STATICLIB) not found; run 'build' first"; exit 1; }
	rm -rf dist/$(ARTIFACT_NAME)
	mkdir -p dist/$(ARTIFACT_NAME)/sysroot/lib \
	         dist/$(ARTIFACT_NAME)/sysroot/include/libxml2/libxml \
	         dist/$(ARTIFACT_NAME)/sysroot/bin
	cp -f $(STATICLIB) dist/$(ARTIFACT_NAME)/sysroot/lib/
	cp -f include/libxml/*.h dist/$(ARTIFACT_NAME)/sysroot/include/libxml2/libxml/
	@echo '#!/bin/sh' > dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	@echo 'case "$$1" in' >> dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	@echo '  --cflags) echo "-I$${NANVIX_HOME:-/mnt/sysroot}/include/libxml2" ;;' >> dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	@echo '  --libs)   echo "-L$${NANVIX_HOME:-/mnt/sysroot}/lib -lxml2 -lz" ;;' >> dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	@echo '  --version) echo "2.12.9" ;;' >> dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	@echo 'esac' >> dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	chmod +x dist/$(ARTIFACT_NAME)/sysroot/bin/xml2-config
	tar -czf dist/$(ARTIFACT_NAME).tar.gz -C dist/$(ARTIFACT_NAME) sysroot
	@echo "  Package: dist/$(ARTIFACT_NAME).tar.gz"

verify-package:
	@echo "=== Verifying libxml2 package ==="
	$(eval ARTIFACT_NAME := libxml2-$(PLATFORM)-$(PROCESS_MODE)-$(MEMORY_SIZE))
	@test -f "dist/$(ARTIFACT_NAME).tar.gz" || { echo "  FAIL: tarball not found"; exit 1; }
	@tar tzf "dist/$(ARTIFACT_NAME).tar.gz" | grep -q 'sysroot/lib/libxml2.a' || { echo "  FAIL: missing libxml2.a"; exit 1; }
	@echo "  PASS: libxml2 package verification"

# ===========================================================================
# Clean
# ===========================================================================

clean:
	-$(MAKE) clean 2>/dev/null || true
	rm -f $(TEST_ELF) Makefile
	rm -rf dist/ .libs/

.PHONY: all clean test test-smoke test-integration test-functional package verify-package
